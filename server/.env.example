# Bhumi Sahyog — Environment Configuration Template
PORT=3001
NODE_ENV=development

# Groq Cloud AI API Key (for Farmer NLP AI Assistant & Live WhatsApp Chat)
# Get your free key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# WhatsApp Multi-Device Integration (Baileys WebSockets)
WHATSAPP_ENABLED=true
ADMIN_WHATSAPP_PHONE=7727038430

# Email Service (Optional - Resend API)
RESEND_API_KEY=

# Firebase Admin SDK (Optional - Service Account JSON String for Backend Firestore sync)
FIREBASE_SERVICE_ACCOUNT_JSON=
